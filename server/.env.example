# Server Configuration
PORT=5000
NODE_ENV=development

# Open Food Facts API (Free - No Key Required)
# We use Open Food Facts API for barcode scanning
FOOD_API_BASE_URL=https://world.openfoodfacts.org/api/v2

# EDAMAM API (Optional - For meal search)
# Get free API key from: https://developer.edamam.com/
EDAMAM_APP_ID=your_app_id_here
EDAMAM_APP_KEY=your_app_key_here
